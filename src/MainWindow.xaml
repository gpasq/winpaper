<Window x:Class="Paperboy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Paperboy"
        Title="Paperboy" Width="420" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="True" UseLayoutRounding="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <StackPanel Margin="14">
        <!-- Header -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Paperboy" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
            <Border Grid.Column="1" Background="{DynamicResource PlaceholderBrush}" CornerRadius="6" Padding="2">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RecentTab" Style="{StaticResource Segment}" Content="Recent" IsChecked="True"
                                 GroupName="Source" Checked="Source_Changed" />
                    <RadioButton x:Name="ArchiveTab" Style="{StaticResource Segment}" Content="Archive"
                                 GroupName="Source" Checked="Source_Changed" />
                </StackPanel>
            </Border>
            <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <local:Spinner x:Name="RefreshSpinner" Margin="6" Visibility="Collapsed" />
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;"
                        ToolTip="Refresh" Click="Refresh_Click" />
            </Grid>
        </Grid>

        <!-- Archive controls -->
        <DockPanel x:Name="ArchiveControls" Margin="0,0,0,10" Visibility="Collapsed">
            <Button x:Name="YearButton" Click="Year_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="YearLabel" />
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="8,1,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Fg2Brush}" />
                </StackPanel>
            </Button>
            <Button x:Name="MonthButton" Click="Month_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="MonthLabel" />
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="8,1,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Fg2Brush}" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="&#xE8B1;"
                    FontFamily="{StaticResource IconFont}" FontSize="14" Padding="9,5"
                    ToolTip="Random image from the archive" Click="Shuffle_Click" />
        </DockPanel>

        <!-- Preview -->
        <StackPanel x:Name="Preview" Margin="0,0,0,10">
            <Border x:Name="PreviewImage" Height="220" CornerRadius="8" local:RemoteImage.DecodeWidth="1000" />
            <TextBlock x:Name="PreviewTitle" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="PreviewCaption" FontSize="12" Foreground="{DynamicResource Fg2Brush}" Margin="0,6,0,0"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="16"
                       LineStackingStrategy="BlockLineHeight" MaxHeight="32" />
            <DockPanel Margin="0,6,0,0">
                <TextBlock x:Name="PreviewDate" FontSize="12" Foreground="{DynamicResource Fg3Brush}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <local:Spinner x:Name="BusySpinner" Margin="0,0,8,0" Visibility="Collapsed" />
                    <Button x:Name="DownloadButton" Content="Download" Margin="0,0,8,0" Click="Download_Click" />
                    <Button x:Name="ApplyButton" Style="{StaticResource AccentButton}" Content="Set as Wallpaper"
                            Click="Apply_Click" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <!-- Thumbnail grid (rows of three, virtualized) -->
        <Grid Height="220" Margin="0,0,0,10">
            <ItemsControl x:Name="Thumbs" VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="Scroller" Focusable="False" CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding}" Margin="-4,0,-4,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ThumbItem}">
                                    <Grid Margin="4,0" Height="68" Background="Transparent" ToolTip="{Binding Image.Title}"
                                          MouseLeftButtonUp="Thumb_Click">
                                        <Border CornerRadius="6" local:RemoteImage.DecodeWidth="280"
                                                local:RemoteImage.Url="{Binding Image.ThumbnailUrl}" />
                                        <Border CornerRadius="6" BorderThickness="3" BorderBrush="{DynamicResource AccentBrush}"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5"
                                              Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                            <Ellipse Width="17" Height="17" Fill="{DynamicResource AccentBrush}"
                                                     Stroke="White" StrokeThickness="1.5" />
                                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <local:Spinner x:Name="GridSpinner" Width="24" Height="24" Visibility="Collapsed" />
            <TextBlock x:Name="GridEmpty" Text="No images for this month" Foreground="{DynamicResource Fg2Brush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>

        <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                   Margin="0,0,0,10" Visibility="Collapsed" />

        <Rectangle Height="1" Fill="{DynamicResource LineBrush}" Margin="0,0,0,10" />

        <CheckBox x:Name="AutoApplyCheck" Content="Automatically use today's image" Margin="0,0,0,8"
                  Click="AutoApply_Click" />
        <CheckBox x:Name="LaunchCheck" Content="Launch at login" Margin="0,0,0,10" Click="Launch_Click" />

        <DockPanel>
            <Button Content="Open Folder" Click="OpenFolder_Click" />
            <Button Content="Quit" HorizontalAlignment="Right" ToolTip="Ctrl+Q" Click="Quit_Click" />
        </DockPanel>
    </StackPanel>
</Window>
